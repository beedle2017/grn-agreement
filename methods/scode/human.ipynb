   "source": [
    "adata = scv.datasets.bonemarrow()\n",
    "\n",
    "sc.pp.filter_genes(adata, min_counts=1)\n",
    "\n",
    "# Normalize gene expression matrix with total UMI count per cell\n",
    "sc.pp.normalize_per_cell(adata, key_n_counts='n_counts_all')\n",
    "\n",
    "adata.to_df()"
   ]
